# ═══════════════════════════════════════════════════════════════════════════════
# AG-UI Travel Agent — demo configuration
# ═══════════════════════════════════════════════════════════════════════════════
#
# QUICK START
#   1. cp .env.example .env
#   2. Fill in the sections below (PingOne values, API keys)
#   3. docker compose up --build
#   4. Open http://localhost:3000
#
# WITH PINGGATEWAY (optional middleware layer between Agent and MCP servers)
#   docker compose -f docker-compose.yml -f docker-compose.gateway.yml up --build
#
# ─────────────────────────────────────────────────────────────────────────────
# OAUTH AUTHORIZATION SERVER
# ─────────────────────────────────────────────────────────────────────────────
# These OIDC_* variables are the single source of truth for the AS config.
# docker-compose.yml maps them into each service's expected env var names.
# To use a different AS, just swap these four values — no per-service env
# files need to change.
#
# PingOne example:
#   OIDC_ISSUER         = https://auth.pingone.com/<ENV_ID>/as
#   OIDC_JWKS_URI       = https://auth.pingone.com/<ENV_ID>/as/jwks
#   OIDC_TOKEN_ENDPOINT = https://auth.pingone.com/<ENV_ID>/as/token

OIDC_ISSUER=https://auth.pingone.com/YOUR_ENV_ID/as
OIDC_JWKS_URI=https://auth.pingone.com/YOUR_ENV_ID/as/jwks
OIDC_TOKEN_ENDPOINT=https://auth.pingone.com/YOUR_ENV_ID/as/token

# ─────────────────────────────────────────────────────────────────────────────
# WEB APP (Next.js / Auth.js)
# ─────────────────────────────────────────────────────────────────────────────
# Generate AUTH_SECRET with:  openssl rand -base64 32
AUTH_SECRET=

# PingOne application: Authorization Code + PKCE grant.
# Redirect URI to register in PingOne:  <AUTH_URL>/api/auth/callback/pingone
AUTH_CLIENT_ID=
AUTH_CLIENT_SECRET=

# Public URL of the web app. Change for non-localhost deployments.
AUTH_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────────────────────
# AGENT (LangGraph JS)
# ─────────────────────────────────────────────────────────────────────────────
# Gemini API key — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# PingOne application: Client Credentials + Token Exchange grants.
# This agent holds its own credentials (never exposed to the browser).
AGENT_CLIENT_ID=
AGENT_CLIENT_SECRET=

# MCP server routing. Each entry must include url and scope.
# scope determines which PingOne Resource (and thus aud) appears in the TX token.
# For local dev (override in docker-compose; these are the docker-internal addresses):
#
# MCP_SERVERS={"travel":{"url":"http://localhost:3100/mcp","scope":"mcp:travel_tools"},
#              "weather":{"url":"http://localhost:3150/mcp","scope":"mcp:weather_tools"}}

# ─────────────────────────────────────────────────────────────────────────────
# MCP SERVER AUDIENCES
# ─────────────────────────────────────────────────────────────────────────────
# These MUST exactly match the Resource URL registered in PingOne for each
# MCP server — PingOne inserts the Resource URL as the token's aud claim.
# The MCP servers validate that their MCP_AUDIENCE matches the aud claim.
#
# For local/docker demo:  keep as http://localhost:3100 and :3150
# For a deployed demo:    set to your public URLs (e.g. https://demo.example.com/travel)

TRAVEL_SERVER_AUDIENCE=http://localhost:3100
WEATHER_SERVER_AUDIENCE=http://localhost:3150

# ─────────────────────────────────────────────────────────────────────────────
# INTERNAL / OPTIONAL
# ─────────────────────────────────────────────────────────────────────────────
# Shared API key between mcp-travel and the travel-api backend service.
# Generate with:  openssl rand -hex 32
TRAVEL_API_KEY=dev-travel-api-key-change-in-production

# PingGateway image (only used with docker-compose.gateway.yml).
# Community/eval:   pingidentity/openig:latest
# Licensed:         registry.pingidentity.com/pinggateway/pinggateway:<version>
PINGGATEWAY_IMAGE=pingidentity/openig:latest

# Path to your PingGateway config directory (mounted into the container).
# Configure routes inside PingGateway to proxy:
#   /travel/* → http://mcp-travel:3100   (strip /travel prefix)
#   /weather/* → http://mcp-weather:3150 (strip /weather prefix)
PINGGATEWAY_CONFIG_DIR=/path/to/your/openig-config

# ─────────────────────────────────────────────────────────────────────────────
# PORT OVERRIDES (optional — defaults shown)
# Change any of these if another service is already using the default port.
# ─────────────────────────────────────────────────────────────────────────────
# WEB_PORT=3000
# AGENT_PORT=8123
# TRAVEL_PORT=3100
# WEATHER_PORT=3150
# GATEWAY_PORT=9000
