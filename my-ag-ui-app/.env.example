AGENT_URL=http://localhost:8123

# RFC 8707 Resource Indicator — the Agent's URL.
# PingOne sets aud=AUTH_AGENT_RESOURCE on the person token issued at login.
# The person token is the RFC 8693 subject_token; only the Agent (holding its
# own client credentials) can use it to perform Token Exchange for MCP servers.
AUTH_AGENT_RESOURCE=http://localhost:8123
